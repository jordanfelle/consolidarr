{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommitsDisabled"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on saturday"],
  "prConcurrentLimit": 5,
  "postUpdateOptions": ["gomodTidy", "npmDedupe"],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Group and automerge minor/patch updates once CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Majors need a human",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major"]
    },
    {
      "description": "Keep the Go toolchain image, setup-go and go.mod's go directive moving together",
      "matchDatasources": ["docker", "golang-version", "github-actions"],
      "matchPackageNames": ["golang", "go", "actions/setup-go"],
      "groupName": "go toolchain"
    }
  ]
}
