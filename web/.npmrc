# npm 12 refuses "remote" (tarball-URL) packages unless allowed. Tailwind's optional WASM build
# (@tailwindcss/oxide-wasm32-wasi) is recorded in the lockfile as a registry tarball URL, so any lockfile
# *regeneration* under npm 12 (Renovate's artifact step) fails with EALLOWREMOTE and Renovate PRs
# end up with a package.json/package-lock.json mismatch that `npm ci` rejects.
# `npm ci` from the existing lockfile is unaffected; `root` is not enough (the package is transitive).
# Git and file dependencies stay blocked by npm 12's defaults.
allow-remote=all
